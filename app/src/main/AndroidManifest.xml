<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 按键触感直接走 Vibrator（issue #15 真机返工）：系统触摸振动
         总开关在 Android 14+ 会拦截 performHapticFeedback，直连通道
         需要 VIBRATE 权限。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- the setup page performs the audited HTTPS keyboard update. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Model download consent checks whether the active network is metered. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 词库编译保活（CompileGuardService）：分钟级批处理跑在设置页进程，
         无 FGS 时灭屏数分钟即被厂商系统清理（ace 实录 am_proc_died）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Feelime"
        android:usesCleartextTraffic="true">
        <!-- Plain http is admitted for LAN model mirrors / custom sources;
             every download is verified against the embedded SHA-256 manifest
             (and keyboard updates against Ed25519), so the transport is not
             the trust boundary. -->

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ImePickerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.Feelime.Picker" />

        <!-- 语音首用权限弹窗的透明壳（userdata.md §2）：只为替 IME Service
             发起 requestPermissions，收到结果即 finish，不进最近任务。
             注意不能 noHistory：官方明确要求请求权限的 Activity 不能用它，
             否则授权回调不可靠。
             taskAffinity 置空：Service 的 NEW_TASK 启动否则会复用同包
             SetupActivity 的任务栈，把输入法设置界面顶到前台打断输入流
             （用户反馈）；空 affinity 让它自起空任务，透明壳叠在用户
             当前界面上。 -->
        <activity
            android:name=".VoicePermissionActivity"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".ImeTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_feelime"
            android:label="@string/ime_tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".FeelimeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- 词库编译保活（specialUse：设备端词库重编译，用户在设置页
             主动发起的分钟级批处理，见 CompileGuardService 注释）。 -->
        <service
            android:name=".engine.CompileGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="device-side dictionary recompilation initiated by the user from the settings page" />
        </service>

        <!-- 诊断导出文件（cache/exports/）经系统分享面板发出（ACTION_SEND）。
             exported=false：只有本应用能拿 uri，跨应用读靠 FLAG_GRANT。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
